# Copy to .env. Never commit .env.
POSTGRES_USER=finresearch
POSTGRES_PASSWORD=change-me

# Leave empty for SQLite at data/finresearch.db (no services needed).
DATABASE_URL=

# OpenAI-compatible LLM gateway (DeepSeek / Qwen / Moonshot / vLLM / OpenAI).
# Leave LLM_BASE_URL empty to run fully offline (deterministic template agents).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL_STRONG=deepseek-chat
LLM_MODEL_LIGHT=deepseek-chat
LLM_OFFLINE=0

# Optional live data
TUSHARE_TOKEN=
