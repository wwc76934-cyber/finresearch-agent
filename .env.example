# Copy to .env. Never commit .env.
POSTGRES_USER=finresearch
POSTGRES_PASSWORD=change-me

# Storage / vector / tracing backends. Defaults need no services (CI and unit tests use them).
#   STORAGE_BACKEND=sqlite|postgres   postgres uses DATABASE_URL, or localhost:5432 from docker compose
#   VECTOR_BACKEND=memory|pgvector    pgvector needs postgres; run scripts/bootstrap.py to fill the embeddings
#   TRACING_BACKEND=json|otel         otel also emits OpenTelemetry spans (OTEL_EXPORTER_OTLP_ENDPOINT, e.g.
#                                     http://127.0.0.1:6006/v1/traces for Phoenix; empty keeps them in memory)
STORAGE_BACKEND=sqlite
VECTOR_BACKEND=memory
TRACING_BACKEND=json
OTEL_EXPORTER_OTLP_ENDPOINT=
# Leave empty for SQLite at data/finresearch.db (no services needed).
DATABASE_URL=

# OpenAI-compatible LLM gateway. Default: SiliconFlow (硅基流动).
# Leave LLM_API_KEY empty to run fully offline (deterministic template agents).
# Check available model ids with: python scripts/check_llm.py --list
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_API_KEY=
LLM_MODEL_STRONG=deepseek-ai/DeepSeek-V3
LLM_MODEL_LIGHT=Qwen/Qwen2.5-7B-Instruct
LLM_OFFLINE=0
# Prices in 元 per 1M tokens. Copy the real numbers from your provider's pricing page.
LLM_PRICE_STRONG_IN=2
LLM_PRICE_STRONG_OUT=8
LLM_PRICE_LIGHT_IN=0
LLM_PRICE_LIGHT_OUT=0

# Optional live data
TUSHARE_TOKEN=

# Independent judge (different model family from the generator)
LLM_MODEL_JUDGE=Qwen/Qwen2.5-72B-Instruct
# Dense retrieval: hashing (offline stand-in, default) | api (BAAI/bge-m3 via LLM_BASE_URL; vectors cached in .cache/)
EMBEDDING_BACKEND=hashing
EMBEDDING_MODEL=BAAI/bge-m3
